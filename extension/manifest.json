{
  "manifest_version": 3,
  "name": "Sarjy",
  "version": "0.1.0",
  "description": "Talk to a voice agent that browses for you in your own Chrome, from an overlay on any page.",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "icons": { "16": "icons/clippy16.png", "32": "icons/clippy32.png", "48": "icons/clippy48.png", "128": "icons/clippy128.png" },
  "action": { "default_title": "Sarjy: start talking", "default_icon": { "16": "icons/clippy16.png", "32": "icons/clippy32.png", "48": "icons/clippy48.png", "128": "icons/clippy128.png" } },
  "options_page": "setup.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page_reader.js", "page_actions.js", "clippy.js", "overlay_ui.js", "overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
